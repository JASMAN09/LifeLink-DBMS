SECRET_KEY=replace-with-a-long-random-value
# FLASK_SECRET_KEY is also accepted for compatibility with earlier setup docs.
FLASK_SECRET_KEY=
APP_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=lifelink
DB_SSL_CA=
# Optional elevated account for setup_db.py only; otherwise setup_db.py uses DB_USER.
DB_SETUP_USER=
DB_SETUP_PASSWORD=
PORT=5050
FLASK_DEBUG=false
COOKIE_SECURE=false
LOCAL_DEMO_ACCESS=false
# Production first-run only: provide secrets to create the initial admin without demo credentials.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=LifeLink Administrator
LOW_STOCK_THRESHOLD=2
